{
  "type": "object",
  "properties": {
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": { "type": "integer", "description": "PR number of the layer" },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string" },
                "resolution": { "type": "string", "description": "How you resolved it, in a sentence or two" }
              },
              "required": ["path", "resolution"],
              "additionalProperties": false
            }
          },
          "tests": { "type": "string", "description": "What you built and tested for this layer, and the result" }
        },
        "required": ["number", "conflicts", "tests"],
        "additionalProperties": false
      },
      "description": "Each layer you rebased"
    },
    "comment": {
      "type": ["string", "null"],
      "description": "Anything you could not rebase or resolve, and why, or null"
    }
  },
  "required": ["layers", "comment"],
  "additionalProperties": false
}
