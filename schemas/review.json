{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "Review body in GitHub markdown: what the PR does and the overall assessment"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "description": "New-file line number, as prefixed on the diff line"
          },
          "start_line": {
            "type": "integer",
            "description": "First line of a multi-line range, below line"
          },
          "body": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Exact text of the line at `line`, without the number or diff marker"
          }
        },
        "required": [
          "path",
          "line",
          "code",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "approve": {
      "type": "boolean",
      "description": "Approve the PR as ready to merge"
    },
    "approval_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Why the PR is not approved, one short reason each; empty only when approving"
    },
    "resolve": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "thread_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "description": "One sentence on how the concern was addressed"
          }
        },
        "required": [
          "thread_id",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "comments",
    "approve",
    "approval_blockers",
    "resolve"
  ],
  "additionalProperties": false
}
